# In-enclave classifier — runs INSIDE the Nitro Enclave.
# Built into an EIF via `nitro-cli build-enclave --docker-uri ...`.
#
# Model loading: NOT baked here. The 8B Q4_K_M dual-model bundle is
# ~10GB which exceeds nitro-cli 1.4.4's effective initramfs ceiling
# (cpio decompression fails ~5GB+). The parent streams Granite +
# Qwen3Guard over vsock at boot; the enclave verifies each blob's
# SHA-256 against the constants below — and PCR0 measures those
# constants, so a tampered EIF cannot accept a different model.

FROM python:3.12-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Granite Guardian 4.1 ships with the 'granite-docling' pre-tokenizer,
# which only landed in llama.cpp / llama-cpp-python in 0.3.20+. Pin to
# the latest stable so both Granite 4.1 and Qwen3Guard load. cbor2 is
# used by the /dev/nsm wrapper for attestation requests.
RUN pip install --no-cache-dir llama-cpp-python==0.3.21 cbor2==5.6.5 cryptography==44.0.0

COPY src/ /app/src/

# Expected SHA-256 of each GGUF the parent will stream. Defaults
# point at mradermacher's public Q4_K_M mirrors; override at build
# time with --build-arg if you mirror the weights elsewhere.
#
# Compute with: sha256sum granite-guardian-4.1-8b.Q4_K_M.gguf
ARG GRANITE_SHA256=""
ARG QWEN_SHA256=""

ENV PYTHONPATH=/app/src:/usr/local/lib/python3.12/site-packages \
    RG_LOAD_PORT=5006 \
    RG_VSOCK_PORT=5005 \
    RG_MODEL_DIR=/tmp/models \
    RG_MODEL_CTX=4096 \
    RG_MODEL_THREADS=16 \
    RG_GRANITE_SHA256=${GRANITE_SHA256} \
    RG_QWEN_SHA256=${QWEN_SHA256}

# Use absolute interpreter path so the enclave init's exec doesn't
# accidentally pick a different python from PATH.
CMD ["/usr/local/bin/python3", "-m", "retroguard_classifier.server"]
