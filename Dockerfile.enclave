# In-enclave classifier — runs INSIDE the Nitro Enclave.
# Built into an EIF via `nitro-cli build-enclave --docker-uri ...`.
#
# Layout choice: we bake the GGUF model weights into the image so the
# EIF is self-contained on first boot. v2 will pull from S3 + decrypt
# via KMS attestation per spec §5 Tree 2.
#
# Model: ibm-granite/granite-guardian-4.1-8b-gguf (Q4_K_M ~5GB).
# Inference: llama-cpp-python (CPU-only; matches AWS sample).

FROM python:3.12-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install llama-cpp-python (CPU build; openblas optional but skip for simplicity)
RUN pip install --no-cache-dir llama-cpp-python==0.3.6

# Stage the in-enclave server code
COPY src/ /app/src/

# Model: pulled at build time. v1 uses Meta's Llama Guard 3 8B (Q4_K_M
# quantization, ~5GB) which is a safety classifier specifically trained
# for unsafe content detection. Public mirror via QuantFactory (no
# HuggingFace token required). When a HuggingFace token is provided
# at build time, swap to ibm-granite/granite-guardian-4.1-8b-gguf for
# the spec-aligned model.
ARG MODEL_URL=https://huggingface.co/QuantFactory/Llama-Guard-3-8B-GGUF/resolve/main/Llama-Guard-3-8B.Q4_K_M.gguf
RUN mkdir -p /opt/models && \
    curl -L -o /opt/models/guardrail.gguf "$MODEL_URL" && \
    ls -lh /opt/models/

ENV PYTHONPATH=/app/src \
    RG_MODEL_PATH=/opt/models/guardrail.gguf \
    RG_VSOCK_PORT=5005 \
    RG_MODEL_CTX=4096 \
    RG_MODEL_THREADS=32

# Enclave entrypoint; vsock listener inside the enclave.
CMD ["python3", "-m", "retroguard_classifier.server"]
