# In-enclave classifier — runs INSIDE the Nitro Enclave.
# Built into an EIF via `nitro-cli build-enclave --docker-uri ...`.
#
# Model loading: NOT baked here. The full multi-tier bundle is ~13 GB
# (Granite 4.1 8B i1-Q4_K_S + Qwen3Guard-Gen 0.6B/4B/8B Q4_K_M),
# above nitro-cli 1.4.4's effective initramfs ceiling. The parent
# streams each blob over vsock at boot; the enclave verifies each
# SHA-256 against the constants below — and PCR0 measures those
# constants, so a tampered EIF cannot accept a different model.
#
# Tier dispatch:
#   protection_effort=fast    → Qwen3Guard-Gen 0.6B
#   protection_effort=expert  → Qwen3Guard-Gen 4B   (default)
#   protection_effort=heavy   → Qwen3Guard-Gen 8B
#   any tier + custom_criteria → Granite Guardian 4.1 8B (BYOC strength)

FROM python:3.12-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Granite Guardian 4.1 ships with the 'granite-docling' pre-tokenizer
# (llama.cpp / llama-cpp-python 0.3.20+). Qwen3Guard-Gen uses standard
# Qwen3 tokenizer support already in 0.3.x. cbor2 is used by the
# /dev/nsm wrapper for attestation requests.
RUN pip install --no-cache-dir llama-cpp-python==0.3.21 cbor2==5.6.5 cryptography==44.0.0 asn1crypto==1.5.1

COPY src/ /app/src/

# Expected SHA-256 of each GGUF the parent will stream. Compute with
# `python3 scripts/load_models.py --print-hashes --model <label>=<path> ...`.
ARG GRANITE_SHA256=""
ARG QWEN_06B_SHA256=""
ARG QWEN_4B_SHA256=""
ARG QWEN_8B_SHA256=""

ENV PYTHONPATH=/app/src:/usr/local/lib/python3.12/site-packages \
    RG_LOAD_PORT=5006 \
    RG_VSOCK_PORT=5005 \
    RG_MODEL_DIR=/tmp/models \
    RG_MODEL_CTX=4096 \
    RG_MODEL_THREADS=16 \
    RG_GRANITE_SHA256=${GRANITE_SHA256} \
    RG_QWEN_06B_SHA256=${QWEN_06B_SHA256} \
    RG_QWEN_4B_SHA256=${QWEN_4B_SHA256} \
    RG_QWEN_8B_SHA256=${QWEN_8B_SHA256}

# Use absolute interpreter path so the enclave init's exec doesn't
# accidentally pick a different python from PATH.
CMD ["/usr/local/bin/python3", "-m", "retroguard_classifier.server"]
